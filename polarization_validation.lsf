period_value = 0.386e-6;
duty_value = 0.67;
height_value = 210e-9;
incident_angle = 15;
mesh_value = 2e-9;

polarization_values = [0,90];

eta_p1 = zeros(length(polarization_values));
energy_sum = zeros(length(polarization_values));

for(i=1:length(polarization_values)) {

    switchtolayout;

    setnamed("grating_ridge","x span",period_value*duty_value);
    setnamed("grating_ridge","y min",0);
    setnamed("grating_ridge","y max",height_value);

    setnamed("source","angle theta",incident_angle);
    setnamed("source","polarization angle",polarization_values(i));

    setnamed("mesh_grating","dx",mesh_value);
    setnamed("mesh_grating","dy",mesh_value);

    run;

    total_T = -transmission("T_monitor");
    total_R = transmission("R_monitor");
    energy_sum(i) = total_T+total_R;

    order_numbers = gratingn("T_monitor");
    order_power = grating("T_monitor");

    if(sum(order_numbers==1)>0) {
        target_index = find(order_numbers==1);
        eta_p1(i) = order_power(target_index)*total_T;
    } else {
        eta_p1(i) = 0;
    }
}

?"Polarization angle (deg):";
?polarization_values;

?"0 deg = P/TM, 90 deg = S/TE";

?"+1 efficiency (%):";
?eta_p1*100;

?"Energy sum (%):";
?energy_sum*100;

polarization_ratio = max(eta_p1)/min(eta_p1);

?"Max/min polarization efficiency ratio:";
?polarization_ratio;

plot(polarization_values,eta_p1*100,"Polarization angle (deg)","+1 efficiency (%)","Polarization response");