period = 0.386e-6;
duty = 0.67;

# 扫描高度：60–240 nm，步长20 nm
height_values = linspace(60e-9,240e-9,10);

eta_p1 = zeros(length(height_values));

for(i=1:length(height_values)) {

    switchtolayout;

    # 固定最佳占空比67%
    setnamed("grating_ridge",
             "x span",
             period*duty);

    # 光栅从 y=0 向上生长
    setnamed("grating_ridge","y min",0);
    setnamed("grating_ridge","y max",height_values(i));

    run;

    N = gratingn("T_monitor");
    G = grating("T_monitor");
    T_total = -transmission("T_monitor");

    target = find(N==1);
    eta_p1(i) = G(target)*T_total;
}

?"grating height (nm):";
?height_values*1e9;

?"+1 order efficiency (%):";
?eta_p1*100;

best_eta = max(eta_p1);
best_index = find(eta_p1==best_eta);

?"best height (nm):";
?height_values(best_index)*1e9;

?"best +1 efficiency (%):";
?best_eta*100;

plot(height_values*1e9,
     eta_p1*100,
     "Grating height (nm)",
     "+1 order efficiency (%)",
     "Grating height optimization");
