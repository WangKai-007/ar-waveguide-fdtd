period_value = 0.386e-6;
duty_value = 0.65;
height_value = 160e-9;
polarization_value = 90;
mesh_value = 2e-9;

incident_angles = linspace(0,25,11);

eta_p1 = zeros(length(incident_angles));
output_angles = zeros(length(incident_angles));
energy_sum = zeros(length(incident_angles));

for(i=1:length(incident_angles)) {

    switchtolayout;

    setnamed("grating_ridge","x span",period_value*duty_value);
    setnamed("grating_ridge","y min",0);
    setnamed("grating_ridge","y max",height_value);

    setnamed("source","angle theta",incident_angles(i));
    setnamed("source","polarization angle",polarization_value);

    setnamed("mesh_grating","dx",mesh_value);
    setnamed("mesh_grating","dy",mesh_value);

    run;

    total_T = -transmission("T_monitor");
    total_R = transmission("R_monitor");
    energy_sum(i) = total_T+total_R;

    order_numbers = gratingn("T_monitor");
    order_angles = gratingangle("T_monitor");
    order_power = grating("T_monitor");

    if(sum(order_numbers==1)>0) {
        target_index = find(order_numbers==1);
        eta_p1(i) = order_power(target_index)*total_T;
        output_angles(i) = order_angles(target_index);
    } else {
        eta_p1(i) = 0;
        output_angles(i) = 90;
    }
}

?"Incident angles (deg):";
?incident_angles;

?"TE +1 efficiencies (%):";
?eta_p1*100;

?"TE +1 output angles (deg):";
?output_angles;

?"Energy sum (%):";
?energy_sum*100;

maximum_efficiency = max(eta_p1);
maximum_index = find(eta_p1==maximum_efficiency);

?"Maximum efficiency incident angle (deg):";
?incident_angles(maximum_index);

?"Maximum TE +1 efficiency (%):";
?maximum_efficiency*100;

plot(incident_angles,eta_p1*100,"Incident angle (deg)","TE +1 efficiency (%)","Final TE angular efficiency");

plot(incident_angles,output_angles,"Incident angle (deg)","TE +1 output angle (deg)","Final TE angle mapping");